### Search products with facetValueFilters
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json

{
  "query": "query SearchProductsWithFilters($term: String!, $facetValueFilters: [FacetValueFilterInput!], $skip: Int!, $take: Int!) { search(input: { term: $term, skip: $skip, take: $take, facetValueFilters: $facetValueFilters }) { items { productId productName slug description facetValueIds } totalItems } }",
  "variables": {
    "term": "Laptop",
    "skip": 0,
    "take": 12,
    "facetValueFilters": [
      { "facetValueId": "1", "and": true }
    ]
  }
}


