### Search products with options + pagination + totalCount
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json

{
  "query": "
    query SearchProducts($term: String!, $page: Int, $pageSize: Int) {
      searchProductsWithOptions(term: $term, page: $page, pageSize: $pageSize) {
        totalCount
        items {
          productId
          productName
          slug
          description
          productAsset {
            id
            preview
          }
          productFacets {
            id
            name
            code
          }
          variantCount
          minPrice
          maxPrice
          minPriceWithTax
          maxPriceWithTax
          variants {
            variantId
            variantName
            price
            priceWithTax
            options {
              id
              name
            }
            variantFacets {
              id
              name
              code
            }
          }
        }
      }
    }
  ",
  "variables": {
    "term": "laptop",
    "page": 1,
    "pageSize": 10
  }
}

