// Huawei 品牌 (Now Huawei is Laptop product level's facet - brand value)
// (13 OR 15 inch) AND 16GB
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json

{
  "query": "query SearchProductsWithOptions($facetValueIds: [ID!], $optionIds: [ID!], $skip: Int!, $take: Int!) { searchWithOptions(input: { term: \"\", skip: $skip, take: $take, facetValueIds: $facetValueIds, optionIds: $optionIds }) { items { productId productName productVariantName facetValueIds variantOptions { id name } } totalItems totalProducts } }",
  "variables": {
    "skip": 0,
