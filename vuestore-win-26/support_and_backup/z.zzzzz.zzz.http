GET http://192.168.0.53:3000/health

### Add a review (Shop API, requires customer JWT)
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json
Authorization: Bearer 5e1b93dc3358eedc022f44ef7e4e2223e8c71d38c8bde606496c46f66ab465fa

{
  "query": "mutation AddReview($productId: ID!, $rating: Int!, $comment: String!) { addReview(productId: $productId, rating: $rating, comment: $comment) { id rating comment createdAt product { id name slug } customer { id firstName } } }",
  "variables": {
    "productId": "38",
    "rating": 5,
    "comment": "38 ---> Aloe Great product overall!"
  }
}

### Get reviews for a product (Shop API, public)
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json

{
  "query": "query GetReviews($productId: ID!) { reviewsByProduct(productId: $productId) { id rating comment createdAt customer { firstName } } }",
  "variables": {
    "productId": "38"
  }
}

### Delete a review (Admin API, requires admin JWT)
POST http://192.168.0.53:3000/admin-api
Content-Type: application/json
Authorization: Bearer <admin-jwt>

{
  "query": "mutation DeleteReview($id: ID!) { deleteReview(id: $id) }",
  "variables": {
    "id": "1"
  }
}

### List reviews with count (Admin API, requires admin JWT)
POST http://192.168.0.53:3000/admin-api
Content-Type: application/json
Authorization: Bearer <admin-jwt>

{
  "query": "query ListReviewsWithCount($skip: Int, $take: Int, $sortBy: String, $sortOrder: String) { listReviewsWithCount(skip: $skip, take: $take, sortBy: $sortBy, sortOrder: $sortOrder) { items { id rating comment createdAt product { id name } customer { id firstName } } totalCount } }",
  "variables": {
    "skip": 0,
    "take": 5,
    "sortBy": "rating",
    "sortOrder": "DESC"
  }
}
