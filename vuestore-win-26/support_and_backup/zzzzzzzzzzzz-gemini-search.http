### 配置服务器基础地址（根据你前面启动的日志，IP 是 192.168.0.51）
@baseUrl = http://192.168.0.51:3000/shop-api

### 1. 搜索单品规格变体 (Search Variants With Options)
POST {{baseUrl}}
Content-Type: application/json
X-Request-Type: GraphQL

query SearchVariants($term: String!, $page: Int, $pageSize: Int) {
  searchVariantsWithOptions(term: $term, page: $page, pageSize: $pageSize) {
    totalCount
    items {
      variantId
      sku
      variantName
      price
      priceWithTax
      productId
      productName
      slug
      description
      productAsset {
        id
        preview
      }
      variantFacets {
        id
        name
        code
      }
      options {
        id
        name
      }
    }
  }
}

{
  "term": "Laptop", 
  "page": 1,
  "pageSize": 12
}