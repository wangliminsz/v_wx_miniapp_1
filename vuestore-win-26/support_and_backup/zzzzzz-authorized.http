#################################  用 NowPayments Auth 40% 付款 ## OK OK OK OK

POST http://192.168.0.53:3000/shop-api
Content-Type: application/json
Authorization: Bearer {{shop_token}}

{
  "query": "mutation AddPaymentToOrder($input: PaymentInput!) { addPaymentToOrder(input: $input) { __typename ... on Order { payments { id state method metadata } } ... on ErrorResult { errorCode message } } }",
  "variables": {
    "input": {
      "method": "nowpayments_auth",
      "metadata": {}
    }
  }
}

