################################# 订单号 查询 订单 ~ OK OK OK ~ OK OK OK OK OK
# 1️⃣ 查询订单状态 ~~~~~~~~~~~~~~~~~~~~~~~~~~~ OK OK OK  
# "query": "query GetOrder($code: String!) { orderByCode(code: $code) { id code state } }",
# A6D6YNFD9TCCW4AN
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json
Authorization: Bearer {{shop_token}}

{
  "query": "query GetOrder($code: String!) { orderByCode(code: $code) { id code state totalWithTax lines { id productVariant { id name sku } quantity linePriceWithTax } payments { id method state amount transactionId } shippingLines { id priceWithTax shippingMethod { id code name description } } } }",
  "variables": {
    "code": "WY1AK3G8SP2UUQTH"
  }
}

