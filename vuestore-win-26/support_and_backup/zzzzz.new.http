### Test a partial payment of $10.00
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json
Authorization: Bearer {{shop_token}}

{
    "query": "mutation InitiateCustomPayment($amount: Int) { initiateNowPaymentsPayment(amount: $amount) }",
    "variables": {
        "amount": 1000
    }
}

######################### NowPayments 部分支付 Active 订单 ~ OK OK OK ~ OK OK OK OK OK

























# 2️⃣ 转换 Active 订单状态为 ArrangingPayment  / AddingItems / PaymentSettled ~ OK OK OK  
POST http://192.168.0.53:3000/shop-api
Content-Type: application/json
Authorization: Bearer {{shop_token}}

{
  "query": "mutation TransitionOrder($state: String!) { transitionOrderToState(state: $state) { ... on Order { id code state } ... on OrderStateTransitionError { message } } }",
  "variables": {
    "state": "ArrangingPayment"
  }
}


