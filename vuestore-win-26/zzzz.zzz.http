POST {{baseUrl}}
Content-Type: application/json
X-Request-Type: GraphQL

# 注意：去掉了里面的 ($openId: String!)
mutation AuthenticateWithWechat {
  authenticate(input: {
    wechat: {
      openId: "ojaJ13YlqeIniIi0fOLtcHGf_e74"
    }
  }) {
    ... on CurrentUser {
      id
      identifier
    }
    ... on ErrorResult {
      errorCode
      message
    }
  }
}



#################################################

POST {{baseUrl}}
Content-Type: application/json
X-Request-Type: GraphQL

mutation AuthenticateWithWechat($openId: String!) {
  authenticate(input: {
    wechat: {
      openId: "ojaJ13YlqeIniIi0fOLtcHGf_e74"
    }
  }) {
    ... on CurrentUser {
      id
      identifier
    }
    ... on ErrorResult {
      errorCode
      message
    }
  }
}

### 这里就是你传入 openId 的地方（请求体的一部分）
{
  "openId": "oUpwI5t_Xxxxxxx_MockOpenId2026"
}














