### 配置全局变量（根据你的 vendure-config.ts 配置）
@baseUrl = http://192.168.0.51:3000/shop-api


#################################################



POST {{baseUrl}}
Content-Type: application/json
X-Request-Type: GraphQL

mutation AuthenticateWithWechat($openId: String!, $nickname: String, $lastName: String, $phoneNumber: String) {
  authenticate(input: {
    wechat: {
      openId: $openId,
      nickname: $nickname,
      lastName: $lastName,
      phoneNumber: $phoneNumber
    }
  }) {
    ... on CurrentUser {
      id
      identifier
    }
  }
}

{
  "openId": "ojaJ13YlqeIniIi0fOLtcHGf_test_03",
  "nickname": "耶律大石",
  "lastName": "山西晋中太谷喷涂公司",
  "phoneNumber": "13800138000"
}






#################################################


POST {{baseUrl}}
Content-Type: application/json
X-Request-Type: GraphQL

mutation AuthenticateWithWechat {
  authenticate(input: {
    wechat: {
      openId: "ojaJ13YlqeIniIi0fOLtcHGf_e74",
      nickname: "耶律大石"
    }
  }) {
    ... on CurrentUser {
      id
      identifier
    }
    ... on ErrorResult {
      errorCode
      message
    }
  }
}

### 传入你想测试的不同用户的 OpenId 和 昵称
{
  "openId": "ojaJ13YlqeIniIi0fOLtcHGf_e74",
  "nickname": "Daisy Chan"
}





