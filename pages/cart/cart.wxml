<custom-nav title="采购车" showBack="{{true}}" bgColor="#ffffff" bind:back="onNavBack"></custom-nav>

<!-- 加载状态 -->
<view wx:if="{{isLoading}}" class="loading-overlay">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>

<block wx:elif="{{isLogin}}">

  <!-- EMPTY CART → NOW OUTSIDE, CAN ALIGN PERFECTLY -->
  <view class="empty-state" wx:if="{{cartItems.length === 0}}">

    <text class="empty-title">采购车是空的</text>
    <text class="empty-hint">快去添加商品吧</text>
    <navigator url="/pages/category/category" open-type="switchTab" class="go-shopping-btn" hover-class="go-shopping-btn-active">去采购</navigator>

  </view>

  <!-- NORMAL CONTENT -->
  <view class="container" wx:elif="{{cartItems.length > 0}}">


    <!-- 同步状态提示 -->
    <view wx:if="{{syncStatus}}" class="sync-status">
      <text class="sync-text">{{syncStatus}}</text>
    </view>

    <!-- 采购车列表 -->
    <view class="cart-list" wx:if="{{cartItems.length > 0}}">
      <view class="cart-item" wx:for="{{cartItems}}" wx:key="variantId">
        <!-- 商品图片 -->
        <image src="{{item.image}}" mode="aspectFill" class="item-image" lazy-load></image>

        <!-- 商品信息 -->
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-sku">{{item.sku || 'N/A'}}</text>
          <view class="item-price-row">
            <text class="item-price">¥ {{item.price}}</text>
            <!-- <text class="item-stock" wx:if="{{item.stock}}">库存: {{item.stock}}</text> -->
          </view>

          <!-- 数量控制 -->
          <view class="quantity-control">
            <view class="quantity-btn minus" bindtap="onMinus" data-line-id="{{item.id}}">
              <text>-</text>
            </view>
            <view class="quantity-input-wrap">
              <input type="number" class="quantity-input" value="{{item.quantity}}" bindchange="onQuantityChange" data-line-id="{{item.id}}" />
              <text class="quantity-unit">kg</text>
            </view>
            <view class="quantity-btn plus" bindtap="onPlus" data-line-id="{{item.id}}">
              <text>+</text>
            </view>
          </view>

          <view style="height: 30rpx;"></view>
          <view class="flex flex-row justify-between">
            <view>
              <!-- 🔑 附加费（开机费）— 仅在该行触发了开机费时显示，紧凑"开机费 +¥X"格式
               位置：line total 上方，提示用户该商品未达起批量触发了附加费 -->
              <view class="item-setup-fee" wx:if="{{item.setupFee}}">
                <text class="item-setup-fee-label">开机费</text>
                <text class="item-setup-fee-amount">+ {{item.setupFee}}</text>
              </view>
            </view>
            <view>
              <!-- 小计 -->
              <text class="item-line-total">¥ {{item.lineTotal}}</text>
            </view>
          </view>
        </view>

        <!-- 删除按钮 -->
        <view class="item-delete" bindtap="onDelete" data-line-id="{{item.id}}">
          <text class="delete-icon">×</text>
        </view>
      </view>
    </view>


    <!-- 底部工具栏 -->
    <view class="bottom-bar" wx:if="{{cartItems.length > 0}}">
      <!-- 合计
           🔑 开机费说明已经移到每个商品行内显示（line total 上方）
           这里只显示最终合计金额，金额 = 商品小计 + 开机费 + 运费（来自后端 totalWithTax） -->
      <view class="total-section">
        <view class="total-row">
          <text class="total-label">合计:</text>
          <text class="total-price">¥ {{totalPrice}}</text>
        </view>
        <!-- <text class="total-hint">满减优惠将自动计算</text> -->
      </view>

      <!-- 结算按钮 -->
      <!-- ({{totalCount}}) -->
      <button class="checkout-btn" bindtap="onCheckout">
        提 交
      </button>
    </view>
  </view>

</block>

<!-- -->
