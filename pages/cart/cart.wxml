    <view class="empty-state" wx:if="{{cartItems.length === 0}}">

      <text class="empty-title">采购车是空的</text>
      <text class="empty-hint">快去添加商品吧</text>
      <navigator url="/pages/category/category" open-type="switchTab" class="go-shopping-btn" hover-class="go-shopping-btn-active">去采购</navigator>

    </view>


  </view>
