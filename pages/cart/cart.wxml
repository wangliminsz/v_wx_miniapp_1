      </view>
      <text class="login-title">暂未登录</text>
      <text class="login-desc">登录后即可加入采购车</text>
      <navigator url="/pages/mine/mine" open-type="switchTab" class="login-btn" hover-class="login-btn-active">
        <text>去登录</text>
