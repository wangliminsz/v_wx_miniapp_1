.container {
  min-height: 100vh;
  background-color: #F2F3F5;
}

.hero-section {
  width: 100%;
  position: relative;
}

.hero-swiper {
  width: 100%;
  height: 400rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
  padding: 48rpx 32rpx 32rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.hero-subtitle {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

.section-header {
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.section-title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D2129;
  line-height: 1.4;
}

.collections-section {
  padding: 32rpx;
  background-color: #F2F3F5;
}

.collections-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.collection-card {
  width: 31%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #F2F3F5;
  transition: transform 0.2s;
  margin-bottom: 16rpx;
}

.collection-card-active {
  transform: scale(0.96);
  opacity: 0.85;
}

.collection-image-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.collection-image {
  width: 80%;
  height: 140rpx;
  background-color: #F2F3F5;
  border-radius: 12rpx;
}

.collection-info {
  text-align: center;
  padding: 8rpx 12rpx 20rpx;
}

.collection-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1D2129;
  display: block;
}

.collection-count {
  font-size: 22rpx;
  color: #86909C;
}

.collection-texts {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #86909C;
  font-size: 28rpx;
}

