<view class="loading-overlay" wx:if="{{isLoading}}">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>

<!-- 原生风格自定义导航栏 -->
<view class="nav-bar" style="padding-top: {{safeAreaTop}}px;">
  <view class="nav-bar-inner">
    <view class="nav-bar-left" bindtap="goBack">
      <view class="nav-back-icon"></view>
    </view>
    <view class="nav-bar-center">
      <text class="nav-bar-title">订单历史详情</text>
    </view>
    <view class="nav-bar-right"></view>
  </view>
</view>

<view class="container" style="padding-top: {{navBarHeight + safeAreaTop}}px;">
  <!-- 订单概要 -->
  <view class="order-summary" wx:if="{{orderCode}}">
    <view class="summary-row">
      <text class="summary-label">订单号:</text>
      <text class="summary-value">{{orderCode}}</text>
    </view>
    <view class="summary-row">
      <text class="summary-label">状态:</text>
      <text class="summary-value state-label">{{stateLabel}}</text>
    </view>
  </view>

  <!-- 历史记录列表 -->
  <view class="history-section">
    <view class="section-title-bar">
      <text class="section-title">操作历史</text>
    </view>

    <view wx:if="{{!isLoading && historyEntries.length === 0}}" class="empty-history">
      <text>暂无历史记录</text>
    </view>

    <view class="history-list">
      <view wx:for="{{historyEntries}}" wx:key="id" class="history-item">
        <view class="timeline-dot"></view>
        <view class="history-content">
          <view class="history-header">
            <text class="history-type">{{item.typeLabel}}</text>
            <text class="history-date">{{item.formattedDate}}</text>
          </view>
          <view class="history-detail" wx:if="{{item.detail}}">
            <text>{{item.detail}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
