.container {
  min-height: 100vh;
  background-color: #F2F3F5;
  padding-bottom: 20rpx;
}


.filter-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

/* 搜索栏 */
.search-bar {
  background-color: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.search-box {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  flex: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}

.clear-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.clear-icon {
  font-size: 40rpx;
  color: #86909C;
  line-height: 1.5;
  margin-bottom: 2px;
}

.search-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  border-radius: 16rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  margin-left: auto;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #86909C;
}

.sort-icon {
  margin-left: 8rpx;
  font-size: 24rpx;
}

.filter-item {
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background-color: #F2F3F5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #4E5969;
}

.filter-item.active {
  background-color: #165DFF;
  color: #fff;
}

.order-list {
  padding: 24rpx;
}

.loading, .empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #86909C;
  font-size: 28rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #F2F3F5;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-code {
  font-size: 26rpx;
  color: #86909C;
  padding: 4rpx 8rpx;
  margin-left: -8rpx;
  border-radius: 6rpx;
  transition: all 0.2s;
}

.order-code:active {
  background-color: #E6F4FF;
  color: #165DFF;
}

.order-state {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.order-state.AddingItems { color: #86909C; background-color: #F2F3F5; }
.order-state.ArrangingPayment { color: #FF7D00; background-color: #FFF7E6; }
.order-state.PaymentAuthorized { color: #165DFF; background-color: #E6F4FF; }
.order-state.PaymentSettled { color: #0E42D2; background-color: #E6F4FF; }
.order-state.PartiallyShipped { color: #722ED1; background-color: #F4ECFF; }
.order-state.Shipped { color: #00B42A; background-color: #F6FFED; }
.order-state.PartiallyDelivered { color: #14C38E; background-color: #E8FFEA; }
.order-state.Delivered { color: #00B42A; background-color: #F6FFED; }
.order-state.Modifying { color: #FF7D00; background-color: #FFF7E6; }
.order-state.ArrangingAdditionalPayment { color: #D4380D; background-color: #FFF2E8; }
.order-state.Cancelled { color: #F53F3F; background-color: #FFF2F0; }

.order-content {
  padding: 16rpx 0;
  border-top: 1rpx solid #F2F3F5;
  border-bottom: 1rpx solid #F2F3F5;
}

.order-line {
  margin-bottom: 16rpx;
}

.order-line:last-child {
  margin-bottom: 0;
}

.order-items {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
  margin-bottom: 8rpx;
}

.line-info {
  display: flex;
  /* justify-content: space-between; */
  align-items: center;
  gap: 10rpx;
}

/* 🔑 商品行内"开机费"小行（与 cart/checkout 页面同款）
   位置：line-info（"单价 * 数量"）下方
   风格：橙色小字 + 紧凑"开机费 +¥X"格式 */
.item-setup-fee {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.3;
}
.item-setup-fee-label {
  color: #86909C;            /* 灰色标签 */
}
.item-setup-fee-amount {
  color: #FF7D00;            /* 橙色金额（辅助色） */
  font-weight: 600;
}

.order-count {
  font-size: 24rpx;
  color: #86909C;
  font-weight: 500;
}

.unit-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #165DFF;
}

.shipping-info {
  margin-top: 30rpx;
}

.fulfillment-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.fulfillment-label {
  color: #86909C;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.fulfillment-text {
  color: #165DFF;
  flex: 1;
}

.fulfillment-details {
  margin-top: 16rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #E8F3FF;
}

.fulfillment-group {
  margin-bottom: 16rpx;
}

.fulfillment-group:last-child {
  margin-bottom: 0;
}

.fulfillment-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #E5E6EB;
  margin-bottom: 12rpx;
}

.fl-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #165DFF;
}

.fl-date {
  font-size: 20rpx;
  color: #86909C;
}

.fl-status {
  font-size: 22rpx;
  color: #00B42A;
  background-color: #F6FFED;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.fl-tracking-code {
  font-size: 22rpx;
  color: #165DFF;
  background-color: #E6F4FF;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  transition: all 0.2s;
}

.fl-tracking-code:active {
  background-color: #165DFF;
  color: #FFFFFF;
}

.fulfill-doc-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin: 8rpx 0;
  background-color: #F2F3F5;
  border: 1rpx solid #E5E6EB;
}

.fulfillment-item {
  padding: 8rpx 0;
}

.fl-item-name-row {
  margin-bottom: 4rpx;
}

.fl-item-name {
  font-size: 26rpx;
  color: #1D2129;
  font-weight: 500;
}

.fl-item-meta-row {
  display: flex;
  gap: 24rpx;
}

.fl-item-meta {
  font-size: 22rpx;
  color: #86909C;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2F3F5;
}

.history-btn {
  padding: 8rpx 24rpx;
  background-color: #F2F3F5;
  color: #165DFF;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: 1rpx solid #E5E6EB;
  transition: all 0.2s;
}

.history-btn:active {
  opacity: 0.7;
  background-color: #E6F4FF;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-date {
  font-size: 24rpx;
  color: #86909C;
}

.order-total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #86909C;
  margin-right: 8rpx;
}

.total-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #165DFF;
}