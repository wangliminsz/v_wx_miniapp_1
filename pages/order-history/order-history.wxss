.container {
  min-height: 100vh;
  background-color: #F2F3F5;
  padding-bottom: 20rpx;
}


.filter-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

/* 搜索栏 */
.search-bar {
  background-color: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.search-box {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  flex: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}

.clear-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.clear-icon {
  font-size: 40rpx;
  color: #86909C;
  line-height: 1.5;
  margin-bottom: 2px;
}

.search-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  border-radius: 16rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  margin-left: auto;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #86909C;
}

.sort-icon {
  margin-left: 8rpx;
  font-size: 24rpx;
}

.filter-item {
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background-color: #F2F3F5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #4E5969;
}

.filter-item.active {
  background-color: #165DFF;
  color: #fff;
}

.order-list {
  padding: 24rpx;
}

.loading, .empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #86909C;
  font-size: 28rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #F2F3F5;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-code {
  font-size: 26rpx;
  color: #86909C;
  padding: 4rpx 8rpx;
  margin-left: -8rpx;
  border-radius: 6rpx;
  transition: all 0.2s;
}

.order-code:active {
  background-color: #E6F4FF;
  color: #165DFF;
}

.order-state {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.order-state.AddingItems { color: #86909C; background-color: #F2F3F5; }
.order-state.ArrangingPayment { color: #FF7D00; background-color: #FFF7E6; }
.order-state.PaymentAuthorized { color: #165DFF; background-color: #E6F4FF; }
.order-state.PaymentSettled { color: #0E42D2; background-color: #E6F4FF; }
.order-state.PartiallyShipped { color: #722ED1; background-color: #F4ECFF; }
.order-state.Shipped { color: #00B42A; background-color: #F6FFED; }
.order-state.PartiallyDelivered { color: #14C38E; background-color: #E8FFEA; }
.order-state.Delivered { color: #00B42A; background-color: #F6FFED; }
.order-state.Modifying { color: #FF7D00; background-color: #FFF7E6; }
.order-state.ArrangingAdditionalPayment { color: #D4380D; background-color: #FFF2E8; }
.order-state.Cancelled { color: #F53F3F; background-color: #FFF2F0; }

.order-content {
  padding: 16rpx 0;
  border-top: 1rpx solid #F2F3F5;
  border-bottom: 1rpx solid #F2F3F5;
}

.order-line {
  margin-bottom: 16rpx;
}

.order-line:last-child {
  margin-bottom: 0;
}

.order-items {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
  margin-bottom: 8rpx;
}

.line-info {
  display: flex;
  /* justify-content: space-between; */
  align-items: center;
  gap: 10rpx;
}

/* 🔑 商品行内"开机费"小行（与 cart/checkout 页面同款）
   位置：line-info（"单价 * 数量"）下方
   风格：橙色小字 + 紧凑"开机费 +¥X"格式 */
.item-setup-fee {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.3;
}
.item-setup-fee-label {
  color: #86909C;            /* 灰色标签 */
}
.item-setup-fee-amount {
  color: #FF7D00;            /* 橙色金额（辅助色） */
  font-weight: 600;
}

/* 🔑 随货样板（OrderLine.customFields.samplePlate，int）
   - 位置：紧接 开机费 下方
   - 颜色：琥珀色 #FF7D00（与开机费保持视觉一致，但用 🪧 图标区分概念）
   - 触发条件：samplePlate > 0
   - 视觉重量：与 开机费 同一级别（都是"额外信息"） */
.line-sample-plate {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 0;             /* 🔑 在 .line-extras-row 内部时取消自身的 margin-top，由父容器统一管理 */
  font-size: 24rpx;
  line-height: 1.3;
}
.line-sample-plate-icon {
  font-size: 24rpx;        /* emoji 自然大小 */
  margin-right: 2rpx;
}
.line-sample-plate-label {
  color: #86909C;          /* 灰色标签 */
}
.line-sample-plate-qty {
  color: #FF7D00;          /* 琥珀色数量（与开机费同色） */
  font-weight: 600;
}

/* 🔑 单行额外信息 row 容器：把"随货样板"和"PDF 附件"放在同一行
   - 位置：order-line 列表中的每个 OrderLine 下方
   - 布局：横向 flex（row），gap 12rpx 让两个块有呼吸
   - flex-wrap: wrap 让小屏（长文件名）自动换行
   - margin-top: 10rpx 给上方元素（数量/价格行）留间距
   - 子元素 .line-sample-plate 和 .line-pdf-attachment 共享同一行
     → 节省纵向空间，订单卡片不会拉得太高 */
.line-extras-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* gap: 120rpx; */
  justify-content: space-between;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

/* 🔑 单行 PDF 附件（OrderLine.customFields.orderLinePdfs）
   - 位置：samplePlate 下方
   - 风格：蓝色链接（与现有 fl-tracking-code 风格一致）+ › 箭头表示可点击
   - 触发条件：orderLinePdfs.id 非空
   - 交互：点击调 onLinePdfTap（图片→previewImage, PDF→downloadFile+openDocument） */
.line-pdf-attachment {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 0;             /* 🔑 在 .line-extras-row 内部时取消自身的 margin-top，由父容器统一管理 */
  padding: 8rpx 14rpx;
  background: #F0F7FF;        /* 极浅蓝底，与蓝色文字呼应 */
  border: 1rpx solid #E6F4FF;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.3;
  /* 关键：让文字和 icon 都不可选中（点按时不会弹出系统复制菜单） */
  user-select: none;
  -webkit-user-select: none;
}
.line-pdf-attachment-hover {
  background: #E6F4FF;        /* 浅蓝 hover 反馈 */
  border-color: #165DFF;
}
.line-pdf-icon {
  /* 🔑 SVG 文件类型 icon（与 variant 详情页"技术文档"同款）
     - width/height 固定，aspectFit 保持比例
     - 比 emoji (26rpx) 略大，视觉更精致
     - flex-shrink: 0 保证不被挤压 */
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}
.line-pdf-meta {
  flex: 1;
  min-width: 0;              /* 让内部 text 可以 truncate */
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  overflow: hidden;
}
.line-pdf-label {
  color: #86909C;            /* 灰色"附件"标签 */
  font-size: 22rpx;
  flex-shrink: 0;
}
.line-pdf-name {
  color: #165DFF;            /* 蓝色文件名（链接色） */
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;       /* 文件名截断用 ellipsis */
}
.line-pdf-arrow {
  color: #165DFF;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 🟦 Fulfillment 级 PDF 附件卡片（fulfillPdfs）
   - 布局：参考 variant 详情页"技术文档"section 的 .file_icon-container
     · 纵向 flex（column）
     · 大 icon 96rpx
     · 名字带 ellipsis
   - 与 line 级别 .line-pdf-attachment（横向小卡片）形成对比
     · line 级别：紧凑横向，适合在 order-line 列表中多行展示
     · fulfillment 级别：纵向突出大卡片，因为一个 fulfillment 至多 1 个 PDF，
       应该视觉上"跳出"提醒用户这是重要附件（送货单/对账单/COA）
   - 位置：fulfillDocs 图片下方、fl-items 列表上方 */
.fulfill-pdf-card {
  /* 🔑 与 variant 的 .file_icon-container 保持一致：
     - 宽度设上限（不能太宽，否则长文件名也需要省略）
     - 纵向 flex、center 对齐
     - gap: 16rpx 让 icon 和 name 有呼吸 */
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 200rpx;
  padding: 16rpx 12rpx;
  margin-top: 12rpx;
  /* 浅蓝底 + 圆角 → 视觉上是一个"可点击的卡片" */
  background-color: #F0F7FF;
  border: 1rpx solid #E6F4FF;
  border-radius: 12rpx;
  /* 防止点按时系统复制菜单弹出 */
  user-select: none;
  -webkit-user-select: none;
}
.fulfill-pdf-card-hover {
  background-color: #E6F4FF;
  border-color: #165DFF;
}
.fulfill-pdf-card-icon {
  /* 🔑 与 variant 的 .file_icon 一致：96rpx x 96rpx
     - aspectFit 保持比例（SVG 本身就是正方形，几乎无影响）
     - flex-shrink: 0 保证不被压缩 */
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}
.fulfill-pdf-card-name {
  /* 🔑 与 variant 的 .doc-name 一致：
     - 24rpx 字号，#1D2129 文字色
     - text-align: center
     - max-width: 100%（跟随 container 宽度）
     - overflow: hidden + text-overflow: ellipsis + white-space: nowrap
       → 长文件名尾部省略号，不会"被截一半" */
  font-size: 24rpx;
  color: #1D2129;
  text-align: center;
  line-height: 1.4;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-count {
  font-size: 24rpx;
  color: #86909C;
  font-weight: 500;
}

.unit-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #165DFF;
}

.shipping-info {
  margin-top: 30rpx;
}

.fulfillment-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.fulfillment-label {
  color: #86909C;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.fulfillment-text {
  color: #165DFF;
  flex: 1;
}

/* 🔑 用户留言（订单级 customFields.customerMessage）— 与"发货状态"同样的样式骨架
   位置：发货状态下方
   视觉：浅灰标签 + 深色文字，支持长文自动换行
   user-select: 让用户可以长按选择复制留言内容 */
.customer-message {
  display: flex;
  align-items: flex-start;   /* 顶部对齐，让长留言可以多行 */
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  background: #F7F8FA;       /* 浅灰底，与上方发货状态区隔 */
  border-radius: 6rpx;
}

.customer-message-label {
  color: #86909C;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.customer-message-text {
  color: #1D2129;
  flex: 1;
  word-break: break-all;     /* 长字符串/URL 自动换行 */
  white-space: pre-wrap;     /* 保留用户输入的换行 */
}

.fulfillment-details {
  margin-top: 16rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #E8F3FF;
}

.fulfillment-group {
  margin-bottom: 16rpx;
}

.fulfillment-group:last-child {
  margin-bottom: 0;
}

.fulfillment-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #E5E6EB;
  margin-bottom: 12rpx;
}

.fl-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #165DFF;
}

/* 🟠 随货样板块徽章容器：让 title + 徽章在一行内
   - flex-wrap: 如果右边运单号过长（运单号在 flex 容器的另一端），
                徽章会换行不挤压
   - gap: 12rpx 让徽章和 title 有呼吸空间 */
.fl-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* 随货样板块徽章（与 reference zzz-refer-1.txt 同款）
   - 药丸形状（rounded-full 近似 999px）
   - 琥珀色系：浅黄底 + 琥珀色文字 + 琥珀色边框
   - 22rpx 字号，比 fl-title 略小，作为"副信息"存在 */
.fl-sample-plate-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #D4880F;              /* 琥珀色文字 */
  background-color: #FFF7E6;   /* 浅琥珀底 */
  border: 1rpx solid #FFD591;  /* 琥珀色边框 */
  border-radius: 999rpx;       /* 药丸形 */
  white-space: nowrap;
}
.fl-sample-plate-icon {
  font-size: 22rpx;
}
.fl-sample-plate-text {
  font-weight: 500;
}

.fl-date {
  font-size: 20rpx;
  color: #86909C;
}

.fl-status {
  font-size: 22rpx;
  color: #00B42A;
  background-color: #F6FFED;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.fl-tracking-code {
  font-size: 22rpx;
  color: #165DFF;
  background-color: #E6F4FF;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  transition: all 0.2s;
}

.fl-tracking-code:active {
  background-color: #165DFF;
  color: #FFFFFF;
}

.fulfill-doc-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin: 8rpx 0;
  background-color: #F2F3F5;
  border: 1rpx solid #E5E6EB;
}

.fulfillment-item {
  padding: 8rpx 0;
}

.fl-item-name-row {
  margin-bottom: 4rpx;
}

.fl-item-name {
  font-size: 26rpx;
  color: #1D2129;
  font-weight: 500;
}

.fl-item-meta-row {
  display: flex;
  gap: 24rpx;
}

.fl-item-meta {
  font-size: 22rpx;
  color: #86909C;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2F3F5;
}

.history-btn {
  padding: 8rpx 24rpx;
  background-color: #F2F3F5;
  color: #165DFF;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: 1rpx solid #E5E6EB;
  transition: all 0.2s;
}

.history-btn:active {
  opacity: 0.7;
  background-color: #E6F4FF;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-date {
  font-size: 24rpx;
  color: #86909C;
}

.order-total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #86909C;
  margin-right: 8rpx;
}

.total-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #165DFF;
}