<!-- 加载状态 -->
<view wx:if="{{isLoading}}" class="loading-overlay">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>

<custom-nav title="订单历史" showBack="{{true}}" bgColor="#ffffff" bind:back="goBack"></custom-nav>

<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view wx:for="{{filters}}" wx:key="key" class="filter-item {{currentFilter === item.key ? 'active' : ''}}" bindtap="onFilterTap" data-key="{{item.key}}">
      {{item.label}}
    </view>

    <view class="sort-btn" bindtap="toggleSortOrder">
      <text>日期</text>
      <text class="sort-icon">{{sortOrder === 'desc' ? '↓' : '↑'}}</text>
    </view>
  </view>

  <!-- 搜索框（仅在"全部" tab 下显示） -->
  <view class="search-bar" wx:if="{{currentFilter === 'all'}}">
    <view class="search-box">
      <view class="search-input-wrapper">
        <input class="search-input" type="text" placeholder="搜索订单号/SKU/商品名" value="{{searchKeyword}}" bindinput="onSearchInput" />
        <view class="clear-icon-wrapper" wx:if="{{searchKeyword}}" bindtap="onSearchClear">
          <text class="clear-icon">×</text>
        </view>
      </view>
      <view class="search-icon-wrapper" bindtap="onSearchClick">
        <image class="search-icon" src="/static/icons/search-360.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!isLoading}}">
    <!-- 无订单 -->
    <view wx:if="{{filteredOrders.length === 0}}" class="empty">
      <text>暂无订单</text>
    </view>

    <!-- 订单列表 -->
    <view wx:else class="orders">
      <view wx:for="{{filteredOrders}}" wx:key="id" class="order-card">
        <view class="order-header">
          <text class="order-code" bindtap="onCopyOrderCode" data-code="{{item.code}}">订单号: {{item.code}}</text>
          <text class="order-state {{item.state}}">{{item.stateLabel}}</text>
        </view>

        <view class="order-content">
          <view class="order-line" wx:for="{{item.formattedLines}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="lineIndex">
            <text class="order-items">{{line.productVariant.name}}</text>

            <view class="flex flex-row justify-between">

              <view class="line-info">
                <text class="order-count">{{line.formattedUnitPrice}}</text>
                <text class="order-count">*</text>
                <text class="order-count">{{line.quantity}} kg</text>
              </view>

              <!-- 🔑 附加费（开机费）— 与 cart/checkout 页面同款-->
              <view class="item-setup-fee" wx:if="{{line.setupFee && line.setupFee !== ''}}">
                <text class="item-setup-fee-label">开机费</text>
                <text class="item-setup-fee-amount">+ {{line.setupFee}}</text>
              </view>

            </view>

            <!-- 🔑 单行额外信息 row 容器：把"随货样板"和"PDF 附件"放在同一行
                 - 用 .line-extras-row 横向 flex 布局
                 - flex-wrap: wrap 让小屏（长文件名）自动换行
                 - gap: 12rpx 让两个块之间有呼吸
                 - 至少一个存在时整行才渲染（避免空 row 浪费空间） -->
            <view class="line-extras-row"
                  wx:if="{{(line.samplePlate && line.samplePlate > 0) || (line.orderLinePdfs && line.orderLinePdfs.id)}}">
              <!-- 🟠 随货样板（OrderLine.customFields.samplePlate，int 类型）
                   - 风格：与开机费同一行视觉重量（都是"额外项"）
                   - 颜色：琥珀色（#FF7D00 系列），与 Fulfill Order modal 的输入框一致
                   - 仅在 > 0 时显示（0 = "无样板"，是默认值，不渲染）
                   - 与 line-pdf-attachment 共用同一行（节省纵向空间） -->
              <view class="line-sample-plate" wx:if="{{line.samplePlate && line.samplePlate > 0}}">
                <text class="line-sample-plate-icon">🪧</text>
                <text class="line-sample-plate-label">随货样板</text>
                <text class="line-sample-plate-qty">× {{line.samplePlate}}</text>
              </view>

              <!-- 🔑 单行 PDF 附件（OrderLine.customFields.orderLinePdfs，relation → Asset）
                   - 可点击：图片走 previewImage，PDF/doc 走 downloadFile + openDocument
                   - 文件类型 icon：与 variant 详情页"技术文档"共用 /static/images/file_icons/*.svg
                     通过文件名后缀匹配（PDF.svg, WORD.svg, EXCEL.svg ...）
                   - 仅在非空时显示
                   - hover-class 给出点击反馈（标准微信 tap 反馈色）
                   - 使用通用 onAttachmentTap handler（与 fulfillment 级 PDF 共享） -->
              <view class="line-pdf-attachment" wx:if="{{line.orderLinePdfs && line.orderLinePdfs.id}}" bindtap="onAttachmentTap" data-attachment-json="{{line.orderLinePdfsJson}}" hover-class="line-pdf-attachment-hover" hover-stay-time="100">
                <image class="line-pdf-icon" src="{{line.orderLinePdfsIconPath}}" mode="aspectFit"></image>
                <view class="line-pdf-meta">
                  <!-- <text class="line-pdf-label">附件</text> -->
                  <text class="line-pdf-name">{{line.orderLinePdfs.name}}</text>
                </view>
                <!-- <text class="line-pdf-arrow">›</text> -->
              </view>
            </view>

          </view>
          <!-- <view class="shipping-info">
            <text class="order-count">运费: {{item.formattedShipping}}</text>
          </view> -->
          <view class="fulfillment-info">
            <text class="fulfillment-label">发货状态:</text>
            <text class="fulfillment-text">{{item.fulfillmentSummary.statusText}}</text>
          </view>

          <!-- 🔑 用户留言 — 显示在"发货状态"下方，订单级 customFields.customerMessage
               - 来源：Order.customFields.customerMessage（后端 schema: text 类型，可空）
               - 仅当非空时显示（兼容老订单没有该字段的情况） -->
          <view class="customer-message" wx:if="{{item.customerMessage && item.customerMessage !== ''}}">
            <text class="customer-message-label">用户留言:</text>
            <text class="customer-message-text" user-select="true">{{item.customerMessage}}</text>
          </view>

          <!-- 发货详情 (每个 fulfillment 一组) -->
          <view class="fulfillment-details" wx:if="{{item.fulfillmentSummary.details.length > 0}}">
            <view wx:for="{{item.fulfillmentSummary.details}}" wx:for-item="fl" wx:for-index="flIndex" wx:key="fulfillmentIndex" class="fulfillment-group">
              
              <view class="fulfillment-group-header">

                <view class="flex flex-col">

                  <view class="fl-title-row">
                    <text class="fl-title">第 {{fl.fulfillmentIndex}} 次发货</text>
                    <!-- 🟠 随货样板块徽章（与 reference zzz-refer-1.txt 同款）
                         - 仅在 fl.samplePlateSum > 0 时显示
                         - 紧贴 fl-title 右侧；若右边运单号过长会被换行（flex-wrap）
                         - 用户一眼能看到"该次发货一共多少块样板" -->
                    <view wx:if="{{fl.samplePlateSum && fl.samplePlateSum > 0}}" class="fl-sample-plate-badge" title="本批发货的随货样板块数">
                      <text class="fl-sample-plate-icon">🪧</text>
                      <text class="fl-sample-plate-text">{{fl.samplePlateSum}} 随货样板</text>
                    </view>
                  </view>

                  <view>
                    <text wx:if="{{fl.fulfillmentDate}}" class="fl-date">{{fl.fulfillmentDate}}</text>
                  </view>

                </view>


                <text class="fl-status" wx:if="{{!fl.trackingCode}}">{{fl.statusText}}</text>
                <block wx:else>

                  <div>
                    <div>
                      <text class="fl-tracking-code">{{fl.statusTextBeforeTracking}}</text>
                    </div>

                    <div>
                      <text class="fl-tracking-code" bindtap="onCopyTrackingCode" data-code="{{fl.trackingCode}}">{{fl.trackingCode}}</text>
                    </div>
                  </div>

                </block>
              </view>

              <view wx:for="{{fl.items}}" wx:for-item="flItem" wx:for-index="flItemIndex" wx:key="flItemIndex" class="fulfillment-item">
                <view class="fl-item-name-row">
                  <text class="fl-item-name">{{flItem.name}}</text>
                </view>
                <view class="fl-item-meta-row">
                  <text class="fl-item-meta">Qty: {{flItem.quantity}}</text>
                  <!-- <text class="fl-item-meta">SKU: {{flItem.sku}}</text> -->
                </view>
              </view>

              <view style="height: 20rpx;"></view>

              <view class="flex gap-4">
                <view>

                  <image wx:if="{{fl.fulfillDocsPreview}}" class="fulfill-doc-image" src="{{fl.fulfillDocsPreview}}" mode="aspectFit" bindtap="previewFulfillDoc" data-preview="{{fl.fulfillDocsPreview}}"></image>

                </view>

                <!-- 🔑 Fulfillment 级 PDF 附件（Fulfillment.customFields.fulfillPdfs）
                     - 位置：fulfillDocs 图片下方
                     - 用途：一般是送货通知/对账单/COA 等正式文档
                     - 点击行为：图片走 previewImage，PDF/doc 走 downloadFile+openDocument
                     - 使用通用 onAttachmentTap handler，data-attachment-json 传完整对象
                     - 仅在 fl.fulfillPdfs.id 非空时显示
                     - 布局：参考 variant 详情页"技术文档"section 的 .file_icon-container
                       · 纵向 flex: icon 在上、name 在下
                       · 大 icon 96rpx（视觉更突出，用户一眼能看到附件）
                       · 名字带 ellipsis 省略号（长文件名友好显示） -->
                <view class="fulfill-pdf-card"
                      wx:if="{{fl.fulfillPdfs && fl.fulfillPdfs.id}}"
                      bindtap="onAttachmentTap"
                      data-attachment-json="{{fl.fulfillPdfsJson}}"
                      hover-class="fulfill-pdf-card-hover"
                      hover-stay-time="100">
                  <image class="fulfill-pdf-card-icon" src="{{fl.fulfillPdfsIconPath}}" mode="aspectFit"></image>
                  <text class="fulfill-pdf-card-name">{{fl.fulfillPdfs.name}}</text>
                </view>



              </view>


            </view>
          </view>
        </view>

        <view class="order-footer">
          <text class="order-date">{{item.formattedDate}}</text>
          <view class="order-total">
            <text class="total-label">合计:</text>
            <text class="total-amount">{{item.formattedTotal}}</text>
          </view>
        </view>

        <view class="order-actions">
          <view class="history-btn" bindtap="onHistoryTap" data-order-id="{{item.id}}" data-order-code="{{item.code}}">
            <text>History</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>