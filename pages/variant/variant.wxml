<view class="container">
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="error-state">
    <text class="error-icon">!</text>
    <text class="error-text">{{error}}</text>
    <button class="error-btn" bindtap="goBack">返回</button>
  </view>


  <view wx:elif="{{variant}}" class="variant-content">

    <!-- 商品图片区 -->
    <!-- <view class="product-images">
      <view class="main-image-container">
        <image wx:if="{{images.length > 0}}" src="{{images[currentImageIndex].preview}}" mode="aspectFit" class="main-image" lazy-load />
        <view wx:else class="no-image">
          <text>暂无图片</text>
        </view>

        <view wx:if="{{images.length > 1}}" class="image-nav">
          <view class="nav-btn prev" bindtap="onPreviousImage">
            <text class="nav-icon">‹</text>
          </view>
          <view class="nav-btn next" bindtap="onNextImage">
            <text class="nav-icon">›</text>
          </view>
        </view>

        <view wx:if="{{images.length > 1}}" class="image-indicator">
          <text>{{currentImageIndex + 1}} / {{images.length}}</text>
        </view>
      </view>

      <view wx:if="{{images.length > 1}}" class="thumbnail-list">
        <view wx:for="{{images}}" wx:key="id" class="thumbnail-item {{currentImageIndex === index ? 'active' : ''}}" bindtap="onImageTap" data-index="{{index}}">
          <image src="{{item.preview}}" mode="aspectFill" class="thumbnail-image" />
        </view>
      </view>
    </view> -->

    <!-- 商品信息区 -->
    <view class="product-info">
      <view class="product-header">
        <text class="product-name">{{variant.name}}</text>
        <text class="product-subtitle">{{product.name}}</text>
        <view class="product-tags" wx:if="{{variant.options && variant.options.length > 0}}">
          <text class="product-tag" wx:for="{{variant.options}}" wx:key="id">{{item.name}}</text>
        </view>
      </view>

      <view class="flex justify-between">
        <view class="price-section">
          <!-- 🔑 关键：使用 displayPriceWithTax（由 basePriceWithTax × 当前 quantity 对应 tier 的 rate 计算得出）
               而不是 variant.priceWithTax（context-dependent，会随 cart 数量变化）。
               保持与 H5 一致：variant 详情页显示基于 quantity 的 tiered 价，cart 显示 context-dependent 计算价。 -->
          <text class="product-price">¥ {{displayPriceWithTax / 100}} 元/kg</text>
          <!-- 阶梯价规则说明（从后端 volumePrices 动态渲染 + 预计算区间文本 + 整数化价格）
               isGroupPrice=true（团购/集团价）时不显示阶梯，按一口价处理 -->
          <view class="tier-hint" wx:if="{{!isGroupPrice && tierDisplayList.length > 0}}">
            <view>
              <view style="height: 5px;"></view>
              <view>阶梯价格说明：</view>
              <view>
                <text class="" wx:for="{{tierDisplayList}}" wx:key="lower">
                  {{item.rangeText}}: ¥ {{item.price}} /kg
                </text>
              </view>
            </view>
          </view>
          <!-- 团购/集团价说明（一口价模式下的占位说明） -->
          <view class="tier-hint group-hint" wx:elif="{{isGroupPrice}}">
            <view>
              <view style="height: 5px;"></view>
              <!-- <view>团购价格说明：</view> -->
              <view class="group-hint-text">VIP 尊享优惠</view>
            </view>
          </view>
        </view>

        <!-- <view class="meta-section"> -->
        <!-- {{variant.stockLevel}} -->
        <!-- <text wx:if="{{variant.sku}}" class="product-sku">{{variant.sku}}</text> -->
        <!-- <text class="stock-status {{getStockLevelClass(variant.stockLevel)}}"> -->
        <!-- {{getStockLevelText(variant.stockLevel)}} -->
        <!-- </text> -->
        <!-- </view> -->
      </view>

      <view style="height:20px;"></view>


      <view class="quantity-section">
        <text class="quantity-label">采购数量</text>
        <view class="quantity-control">
          <view class="quantity-btn minus" bindtap="onMinus">
            <text>-</text>
          </view>

          <!-- ✅ 数量输入带 kg ✅ -->
          <view class="quantity-input-wrap">
            <input type="number" class="quantity-input" value="{{quantity}}" bindchange="onQuantityChange" />
            <text class="quantity-unit">kg</text>
          </view>

          <view class="quantity-btn plus" bindtap="onPlus">
            <text>+</text>
          </view>
        </view>
      </view>



      <view wx:if="{{product.description}}" class="product-description">
        <text class="description-title">商品说明</text>
        <rich-text nodes="{{product.description}}"></rich-text>
      </view>

      <view wx:if="{{techDocs.length > 0}}" class="docs-section">
        <text class="docs-title">技术文档</text>
        <view class="docs-list">
          <view wx:for="{{techDocsWithIcons}}" wx:key="id" wx:for-index="index" class="file_icon-container" bindtap="downloadFile" data-url="{{item.preview}}" data-index="{{index}}">
            <image src="{{item.icon}}" class="file_icon" mode="aspectFit"></image>
            <text class="doc-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{addToCartError}}" class="error-tip">
        <view class="error-tip-content">
          <text class="error-tip-icon">!</text>
          <text class="error-tip-text">{{addToCartError}}</text>
        </view>
        <view class="error-tip-close" bindtap="closeError">
          <text>×</text>
        </view>
      </view>

    </view>

    <view style="height:0px;"></view>

    <!-- 商品图片区 -->
    <view class="product-images">
      <view class="main-image-container">
        <image wx:if="{{images.length > 0}}" src="{{images[currentImageIndex].preview}}" mode="aspectFit" class="main-image" lazy-load />
        <view wx:else class="no-image">
          <text>暂无图片</text>
        </view>

        <view wx:if="{{images.length > 1}}" class="image-nav">
          <view class="nav-btn prev" bindtap="onPreviousImage">
            <text class="nav-icon">‹</text>
          </view>
          <view class="nav-btn next" bindtap="onNextImage">
            <text class="nav-icon">›</text>
          </view>
        </view>

        <view wx:if="{{images.length > 1}}" class="image-indicator">
          <text>{{currentImageIndex + 1}} / {{images.length}}</text>
        </view>
      </view>

      <view wx:if="{{images.length > 1}}" class="thumbnail-list">
        <view wx:for="{{images}}" wx:key="id" class="thumbnail-item {{currentImageIndex === index ? 'active' : ''}}" bindtap="onImageTap" data-index="{{index}}">
          <image src="{{item.preview}}" mode="aspectFill" class="thumbnail-image" />
        </view>
      </view>
    </view>


    <!-- 底部固定操作栏 -->
    <view class="bottom-bar">
      <view class="action-icons">
        <view class="action-icon-item" bindtap="goHome">
          <image src="/static/tabbar/home-n.png" mode="aspectFit"></image>
        </view>
        <view class="action-icon-item cart-icon" bindtap="goToCart">
          <image src="/static/tabbar/cart-n.png" mode="aspectFit"></image>
          <view wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
        </view>
      </view>
      <view class="action-buttons">
        <button class="btn-add-cart" bindtap="addToCart" disabled="{{isAddingToCart || variant.stockLevel === 0 || !isLogin}}" loading="{{isAddingToCart}}">
          {{!isLogin ? '请先登录' : (isAddingToCart ? '加入中...' : '加入采购车')}}
        </button>
      </view>
    </view>
  </view>
</view>