/* ========== 全局 ========== */

.page {
  background-color: #F2F3F5;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1D2129;
}

.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding-top: 20rpx;
  padding-bottom: 60rpx;
}

/* ========== 主体内容 ========== */
.variant-content {
  padding-top: 30rpx;
  background-color: #ffffff;
}

/* ========== 商品图片区 ========== */
.product-images {
  /* background-color: #ffffff; */
  background-color: #ffffff;
  /* margin: 30 30 8rpx; */
  /* padding: 0; */
  padding-top: 30rpx;
  border-radius: 10px;
}

.main-image-container {
  position: relative;
  width: 100%;
  height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  overflow: hidden;
}

.main-image {
  width: 90% !important;
  height: 90% !important;
  border-radius: 30px; /* 圆角大小，自己可调 */
  display: block; /* 必须加，否则圆角不生效 */
}

.no-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #86909C;
  font-size: 28rpx;
}

.image-nav {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.nav-icon {
  font-size: 40rpx;
  color: #1D2129;
  font-weight: bold;
}

.image-indicator {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}

.thumbnail-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  justify-content: center;
}

.thumbnail-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.thumbnail-item.active {
  border-color: #165DFF;
  transform: scale(1.05);
}

.thumbnail-image {
  width: 100%;
  height: 100%;
}

/* ========== 商品信息区 ========== */
.product-info {
  background-color: #ffffff;
  margin-top: 20rpx;
  margin-bottom: 32rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #F2F3F5;
}

.product-header {
  margin-bottom: 24rpx;
}

.product-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1D2129;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.product-subtitle {
  display: block;
  font-size: 28rpx;
  color: #86909C;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.product-tag {
  background-color: #E8F4FF;
  color: #165DFF;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.price-section {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.product-price {
  font-size: 40rpx;
  color: #165DFF;
  /* font-weight: 700; */
}

.tier-hint {
  display: flex;
  flex-direction: column;
  /* gap: 2rpx;              */
  /* 行间距：4rpx → 2rpx，更紧凑 */
  width: 100%;
  margin-top: 8rpx;
  font-size: 26rpx;      /* 28rpx → 26rpx，更精致 */
  font-weight: 500;
  color: #86909C;
  line-height: 1;      
  /* 1.4 → 1.2，收紧行高 */
}

.tier-hint-item {
  display: block;
  line-height: 1.2;      /* 覆盖 <text> 默认行高，避免 1.6 撑开 */
}

/* 团购/集团价说明（一口价占位说明） */
.group-hint {
  /* 复用 .tier-hint 灰色小字风格 */
}

.group-hint-text {
  display: block;
  margin-top: 4rpx;
  color: #FF7D00;        /* 用辅助色橙 #FF7D00 突出团购提示 */
}

.meta-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #F2F3F5;
  border-bottom: 1rpx solid #F2F3F5;
  margin-bottom: 24rpx;
}

.product-sku {
  font-size: 24rpx;
  color: #86909C;
}

.stock-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.stock-in {
  background-color: #E8F8F0;
  color: #00B42A;
}

.stock-low {
  background-color: #FFF3E0;
  color: #FF7D00;
}

.stock-out {
  background-color: #FFF2F0;
  color: #FF4D4F;
}

.product-description {
  margin-bottom: 24rpx;
}

.description-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
}

/* ========== 技术文档区域 ========== */
.docs-section {
  margin: 48rpx 32rpx 24rpx;
  padding: 32rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
}

.docs-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
}

.docs-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.file_icon-container {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.file_icon {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.doc-name {
  font-size: 24rpx;
  color: #1D2129;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

/* ========== 错误提示 ========== */
.error-tip {
  background-color: #FFF7E6;
  border: 1rpx solid #FFE082;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 32rpx 24rpx;
  display: flex;
  align-items: flex-start;
}

.error-tip-content {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.error-tip-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #FA8C16;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.error-tip-text {
  font-size: 28rpx;
  color: #92400E;
  line-height: 1.5;
}

.error-tip-close {
  font-size: 40rpx;
  color: #86909C;
  padding-left: 16rpx;
}

/* ========== 数量选择区 ========== */
.quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  /* margin: 0 16rpx 24rpx; */
  border: 1rpx solid #E5E6EB;
}

.quantity-label {
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
}

.quantity-control {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #E5E6EB;
}

.quantity-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1D2129;
  transition: all 0.2s ease;
}

.quantity-btn:active {
  background-color: #F2F3F5;
}

.quantity-btn.minus {
  border-right: 1rpx solid #E5E6EB;
  border-radius: 16rpx 0 0 16rpx;
}

.quantity-btn.plus {
  border-left: 1rpx solid #E5E6EB;
  border-radius: 0 16rpx 16rpx 0;
}

.quantity-input-wrap {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  min-width: 180rpx;
}

.quantity-input {
  width: 120rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1D2129;
  padding: 0;
  background: transparent;
  border: none;
}

.quantity-unit {
  font-size: 24rpx;
  color: #86909C;
  margin-left: 8rpx;
}

/* ========== 底部固定操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  border-top: 1rpx solid #F2F3F5;
}

.action-icons {
  display: flex;
  gap: 32rpx;
}

.action-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.action-icon-item image {
  width: 56rpx;
  height: 56rpx;
}

.action-icon-item text {
  font-size: 22rpx;
  color: #86909C;
}

.cart-icon {
  position: relative;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  background-color: #F53F3F;
  color: white;
  font-size: 22rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.action-buttons {
  flex: 1;
  margin-left: 32rpx;
}

.btn-add-cart {
  width: 100%;
  background-color: #165DFF;
  color: #ffffff;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  height: 88rpx;
  line-height: 88rpx;
  transition: all 0.2s ease;
}

.btn-add-cart:active {
  opacity: 0.85;
}

.btn-add-cart[disabled] {
  background-color: #94A3B8;
  opacity: 0.7;
}

.btn-add-cart::after {
  border: none;
}

/* ========== 加载状态 ========== */
/* NOTE: Loading styles are now global in app.wxss */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/* ========== 错误状态 ========== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFF2F0;
  color: #FF4D4F;
  font-size: 60rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #1D2129;
}

.error-btn {
  margin-top: 32rpx;
  background-color: #165DFF;
  color: #ffffff;
  padding: 24rpx 64rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
  height: 88rpx;
  line-height: 88rpx;
}

.error-btn::after {
  border: none;
}


